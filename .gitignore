# macOS
.DS_Store

# Go build output
/soroauth
/cmd/soroauth/soroauth
*.test
*.out

# Locally installed developer tools (e.g. golangci-lint under .tools/). CI
# installs its own pinned copy; nothing here is committed.
/.tools/

# Node (golden-vector generator)
node_modules/

# Rust (e2e test contract)
target/

# Soroban test snapshots are regenerated by every `cargo test` run and are not
# part of the fixture's contract with anything.
test_snapshots/

# Python bytecode
__pycache__/
*.pyc
